{
  "services": [{"binding":"YU_ZORA_ERROR_PAGES","service":"yu-zora-main"}],
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "yu-zora-bookshelf",
  "main": "worker/shared-404/index.mjs",
  "compatibility_date": "2026-09-18",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "ratelimits": [{ "name": "PRIVATE_BOOK_LOGIN_LIMITER", "namespace_id": "734662109", "simple": { "limit": 5, "period": 60 } }],
  "routes": [
    { "pattern": "yu-zora.com/bookshelf", "zone_name": "yu-zora.com" },
    { "pattern": "yu-zora.com/bookshelf/*", "zone_name": "yu-zora.com" }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
